// ================= SETUP =================

void setup() {

  Serial.begin(115200);

  IrSender.begin(IR_LED_PIN);

  // WIFI CONNECT
  WiFi.begin(ssid, password);

  Serial.println();
  Serial.print("Connecting");

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);
    Serial.print(".");

  }

  Serial.println();
  Serial.println("WiFi Connected");

  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // ================= WEB ROUTES =================

  server.on("/", []() {

    server.send(200, "text/html", webpage);

  });

  server.on("/on", []() {

    sendPowerOn();

    server.send(200, "text/plain", "AC POWER ON");

  });

  server.on("/off", []() {

    sendPowerOff();

    server.send(200, "text/plain", "AC POWER OFF");

  });

  server.on("/temp", []() {

    if(server.hasArg("value")) {

      int temp = server.arg("value").toInt();

      if(temp >= 16 && temp <= 30) {

        sendTemperature(temp);

        server.send(200, "text/plain",
                    "Temperature Set To " + String(temp) + " C");

      }
      else {

        server.send(400, "text/plain", "Invalid Temperature");

      }

    } else {

      server.send(400, "text/plain", "Temperature Missing");

    }

  });

  server.begin();

  Serial.println("Web Server Started");
}

// ================= LOOP =================

void loop() {

  server.handleClient();

}